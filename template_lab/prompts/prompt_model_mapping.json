{
  "version": "3.0",
  "description": "Model tasks used by the legacy V3 and direct-HTML lesson pipelines.",
  "tasks": {
    "script_structure": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite",
      "provider_models": {
        "gemini": "gemini-3.1-flash-lite",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 64000,
      "provider_env_var": "MAV_SCRIPT_STRUCTURE_PROVIDER",
      "env_var": "MAV_SCRIPT_STRUCTURE_MODEL",
      "prompt_files": ["script_structure.system.txt", "script_structure.user.txt"]
    },
    "script_writing": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite",
      "provider_models": {
        "gemini": "gemini-3.1-flash-lite",
        "anthropic": "claude-opus-4-8"
      },
      "max_tokens": 64000,
      "provider_env_var": "MAV_SCRIPT_WRITING_PROVIDER",
      "env_var": "MAV_SCRIPT_WRITING_MODEL",
      "prompt_files": ["script_writing.system.txt", "script_writing.user.txt"]
    },
    "scene_asset_shortlister": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite",
      "provider_models": {
        "gemini": "gemini-3.1-flash-lite",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 4000,
      "provider_env_var": "MAV_SCENE_ASSET_SHORTLISTER_PROVIDER",
      "env_var": "MAV_SCENE_ASSET_SHORTLISTER_MODEL",
      "prompt_files": ["scene_asset_shortlister.system.txt"]
    },
    "scene_asset_router": {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "provider_models": {
        "gemini": "gemini-3.5-flash",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 12000,
      "provider_env_var": "MAV_SCENE_ASSET_ROUTER_PROVIDER",
      "env_var": "MAV_SCENE_ASSET_ROUTER_MODEL",
      "prompt_files": ["scene_asset_router.system.txt"]
    },
    "module_parameterizer": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite",
      "provider_models": {
        "gemini": "gemini-3.1-flash-lite",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 12000,
      "provider_env_var": "MAV_MODULE_PARAMETERIZER_PROVIDER",
      "env_var": "MAV_MODULE_PARAMETERIZER_MODEL",
      "prompt_files": ["module_parameterizer.system.txt"]
    },
    "v3_creative_director": {
      "provider": "zai",
      "model": "glm-5.2",
      "provider_models": {
        "zai": "glm-5.2",
        "anthropic": "claude-opus-4-8"
      },
      "max_tokens": 16000,
      "provider_env_var": "MAV_V3_CREATIVE_DIRECTOR_PROVIDER",
      "env_var": "MAV_V3_CREATIVE_DIRECTOR_MODEL",
      "prompt_files": ["v3_creative_director.system.txt", "v3_design_system.txt"]
    },
    "v3_scene_coder": {
      "provider": "moonshot",
      "model": "kimi-k2.7-code",
      "provider_models": {
        "moonshot": "kimi-k2.7-code",
        "gemini": "gemini-3.5-flash",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 32000,
      "provider_env_var": "MAV_V3_SCENE_CODER_PROVIDER",
      "env_var": "MAV_V3_SCENE_CODER_MODEL",
      "prompt_files": ["v3_scene_coder.system.txt"]
    },
    "direct_html_composer": {
      "provider": "moonshot",
      "model": "kimi-k2.7-code",
      "provider_models": {
        "moonshot": "kimi-k2.7-code",
        "gemini": "gemini-3.5-flash",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 64000,
      "timeout_seconds": 1800,
      "provider_env_var": "MAV_DIRECT_HTML_COMPOSER_PROVIDER",
      "env_var": "MAV_DIRECT_HTML_COMPOSER_MODEL",
      "prompt_files": ["direct_html_composer.system.txt", "direct_html_design_system.txt"]
    },
    "direct_html_repair": {
      "provider": "moonshot",
      "model": "kimi-k2.7-code",
      "provider_models": {
        "moonshot": "kimi-k2.7-code",
        "gemini": "gemini-3.5-flash",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 24000,
      "timeout_seconds": 1200,
      "provider_env_var": "MAV_DIRECT_HTML_REPAIR_PROVIDER",
      "env_var": "MAV_DIRECT_HTML_REPAIR_MODEL",
      "prompt_files": ["direct_html_repair.system.txt", "direct_html_design_system.txt"]
    },
    "direct_html_review": {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "provider_models": {
        "gemini": "gemini-3.5-flash",
        "anthropic": "claude-sonnet-5"
      },
      "max_tokens": 8000,
      "provider_env_var": "MAV_DIRECT_HTML_REVIEW_PROVIDER",
      "env_var": "MAV_DIRECT_HTML_REVIEW_MODEL",
      "prompt_files": ["direct_html_review.system.txt", "direct_html_design_system.txt"]
    }
  }
}
