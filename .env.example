# Script and scene generation. Gemini is the default low-cost provider.
GEMINI_API_KEY=

# V3 custom scene generation. The default V3 provider is Z.AI.
ZAI_API_KEY=

# Optional provider alternatives.
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
ELEVENLABS_API_KEY=

# Optional model/audio overrides.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
MAV_WHISPER_MODEL=base.en
MAV_V3_SCENE_CONCURRENCY=4

# Optional paid-model request timeouts. Direct HTML defaults to 30 minutes for
# composition and 20 minutes for chapter repair even when these are omitted.
MAV_DIRECT_HTML_COMPOSER_TIMEOUT_SECONDS=1800
MAV_DIRECT_HTML_REPAIR_TIMEOUT_SECONDS=1200
